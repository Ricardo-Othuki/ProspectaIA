# Business Leads AI Automation v2.0 Configuration
# Copy this file to .env and update the values

# REQUIRED: OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL: Custom OpenAI Base URL (for Azure, OpenRouter, local LLM proxies, etc.)
# OPENAI_BASE_URL=https://your-custom-endpoint.com/v1

# INDUSTRY & CAMPAIGN SETTINGS (Set by setup wizard, or override here)
PRIMARY_INDUSTRY=professional
CAMPAIGN_STYLE=balanced

# OUTPUT LANGUAGE (indonesian / english)
OUTPUT_LANGUAGE=indonesian

# SCRAPING CONFIGURATION
DELAY_BETWEEN_SCRAPES=2000
MAX_RETRIES=3
DEFAULT_RESULT_LIMIT=20

# OUTPUT SETTINGS
OUTPUT_FORMAT=csv
OUTPUT_DIRECTORY=output

# LEAD INTELLIGENCE SETTINGS
MIN_LEAD_SCORE=60
ENABLE_LEAD_SCORING=true
PRIORITIZE_HIGH_RATING=true

# MARKETING AI SETTINGS
ENABLE_INDUSTRY_TEMPLATES=true
GENERATE_MULTI_TOUCH=false
MAX_CONTENT_GENERATION=50

# ADVANCED SETTINGS (Optional)
ENABLE_DEBUG_LOGGING=false
SAVE_PROGRESS_LOGS=true
AUTO_CLEANUP_OLD_CAMPAIGNS=false

# NOTE: Business profile (name, phone, email, service description, etc.)
# is configured in business-profile.json — run: npm run setup

# WHATSAPP MONITORING (all targets are opt-in)
# WHATSAPP_PROVIDER=evolution
# EVOLUTION_API_URL=https://your-evolution-api.example
# EVOLUTION_API_KEY=your-evolution-api-key
# EVOLUTION_INSTANCE_NAME=your-instance-name
# WHATSAPP_MONITORING_ADMIN_TOKEN=set-a-long-random-admin-token
# WHATSAPP_MONITORING_WEBHOOK_URL=https://your-public-host/api/agent/inbound
# WHATSAPP_MONITORING_STORE_PATH=data/whatsapp-monitoring.json

# SUPABASE (persistência das conversas do LeadAgent — obrigatório para /api/agent/*)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Nunca use a service_role key no navegador — só o backend lê essa variável.

# LEAD RADAR (varredura de grupos do WhatsApp em busca de pedidos de serviço)
# LEAD_RADAR_MODEL=gemini-2.5-flash-lite
# LEAD_RADAR_POLL_MINUTES=15
# OWNER_NOTIFY_PHONE=5511999999999
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_CHAT_ID=your-telegram-chat-id

# VERCEL / SERVERLESS
# Protege /api/lead-radar/cron/scan (a Vercel envia este valor automaticamente
# como header Authorization quando CRON_SECRET está nas env vars do projeto)
# CRON_SECRET=generate-a-long-random-value

# FUTURE FEATURES (Coming Soon)
# CRM_INTEGRATION=
# EMAIL_SERVICE_API=
# ANALYTICS_TRACKING=
