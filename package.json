{
    "name": "business-scrape-tool",
    "version": "1.0.0",
    "description": "Tool untuk scraping nomor bisnis tanpa website untuk B2B lead generation",
    "main": "index.js",
    "scripts": {
        "setup": "node src/setup.js",
        "campaign": "node src/campaign.js",
        "start": "node index.js",
        "dev": "nodemon index.js",
        "web": "node src/web/server.js",
        "web:dev": "nodemon src/web/server.js",
        "test": "node test.js",
        "test:whatsapp-monitoring": "node test-whatsapp-monitoring.js",
        "test:settings": "node test-settings-store.js",
        "simulate": "node run-flow-simulation.js",
        "test:simulation": "node test-flow-simulation.js",
        "grupos:entrar": "node scripts/entrar-grupos-whatsapp.js",
        "help": "echo 'Available commands:\n  npm run setup     - Interactive setup wizard\n  npm run campaign  - Create and run campaigns\n  npm run web       - Start web dashboard\n  npm run web:dev   - Web dashboard development mode\n  npm start         - Run with CLI arguments\n  npm run dev       - Development mode with auto-reload'"
    },
    "keywords": [
        "scraping",
        "business",
        "leads",
        "b2b",
        "rental-mobil"
    ],
    "author": "Your Name",
    "license": "MIT",
    "dependencies": {
        "@supabase/supabase-js": "^2.117.2",
        "axios": "^1.18.1",
        "dotenv": "^17.0.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.7.1",
        "googleapis": "^173.0.0",
        "openai": "^4.104.0",
        "puppeteer": "^22.8.2",
        "sqlite3": "^5.1.6",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@fission-ai/openspec": "^1.13.2",
        "nodemon": "^3.0.1"
    },
    "engines": {
        "node": ">=14.0.0"
    },
    "nodemonConfig": {
        "ignore": [
            "output/",
            "node_modules/"
        ]
    }
}
